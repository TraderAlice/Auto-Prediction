# Copy to .env.local and keep the value out of Git.
DEEPSEEK_API_KEY=
# Optional: 1-4 explicit model scouts. Default: 1.
PMH_DISCOVERY_FANOUT=1
# Optional cheap-model request budget in milliseconds (1000-300000). The
# five-minute default preserves useful reasoning time; lower it only when the
# resulting latency/quality tradeoff is intentional.
PMH_DISCOVERY_TIMEOUT_MS=300000
# Optional bounded agent-loop budgets. One timeout covers the entire loop,
# not each step. Defaults: 8 model steps and 24 tool calls; maxima: 20 and 64.
PMH_DISCOVERY_MAX_STEPS=8
PMH_DISCOVERY_MAX_TOOL_CALLS=24
# Optional Pi process budget in milliseconds (10000-300000). This is the
# independent deep-lane deadline; it does not consume the fast-lane budget.
PMH_PI_TIMEOUT_MS=300000
# Optional durable deep retry bound (1-5) and fixed lane-handoff allowance
# (0-60000 ms). Retries reuse the retained fast checkpoint and corpus.
PMH_SEARCH_DEEP_MAX_ATTEMPTS=3
PMH_SEARCH_ORCHESTRATION_GRACE_MS=5000
# Optional: 0 keeps catalog refresh manual; otherwise refresh anonymous public
# catalogs every 60000-600000 milliseconds. Keep this below the 15-minute
# context freshness window. Recommended persistent-search value: 300000.
PMH_CATALOG_REFRESH_INTERVAL_MS=0
# Optional: 0 disables scheduling; otherwise 60000-86400000 milliseconds.
PMH_SEARCH_LEASE_INTERVAL_MS=0
# Preferred scheduler: 0 disables automatic issue dispatch; otherwise poll the
# durable priority queue every 1000-60000 milliseconds. Manual issue runs work
# while this is off. When enabled it supersedes the legacy lens timer above.
PMH_SEARCH_ISSUE_TICK_MS=0
# Optional operator notification channel. Use an HTTPS JSON webhook (loopback
# HTTP is accepted for local qualification). The URL stays process-only and
# enabling it never replays messages older than this process activation.
PMH_SEARCH_ATTENTION_WEBHOOK_URL=
# 0 disables automatic semantic review; otherwise poll the durable review queue
# every 1000-60000 milliseconds. Each tick and job remain request-bounded.
PMH_SEMANTIC_REVIEW_TICK_MS=0
# 0 disables automatic rule-document acquisition; otherwise poll durable,
# coalesced evidence requirements every 1000-60000 milliseconds.
PMH_EVIDENCE_ACQUISITION_TICK_MS=0
# Set to 1 only when the local trusted Clash configuration intentionally maps
# public evidence hosts into RFC 2544's 198.18.0.0/15 fake-IP range.
PMH_EVIDENCE_TRUST_CLASH_FAKE_IP=0
# 0 disables automatic Agent interpretation of captured documents; otherwise
# poll requirement×document claim jobs every 1000-60000 milliseconds.
PMH_EVIDENCE_CLAIM_TICK_MS=0
# Optional evidence interpreter overrides. Defaults: DeepSeek V4 Flash,
# 1800 output tokens, five-minute complete tool-loop deadline, concurrency 3.
PMH_EVIDENCE_CLAIM_MODEL=deepseek-v4-flash
PMH_EVIDENCE_CLAIM_MAX_OUTPUT_TOKENS=1800
PMH_EVIDENCE_CLAIM_TIMEOUT_MS=300000
PMH_EVIDENCE_CLAIM_CONCURRENCY=3
# Optional hidden-premise analyst. It runs only when its durable scheduler is enabled.
PMH_PREMISE_ANALYSIS_TICK_MS=0
# The evidence router is enabled at a 15-second cadence by default. Set 0 to
# disable it. It deduplicates unbound premises and searches retained market
# semantics; it cannot fetch arbitrary URLs, certify, simulate, or execute.
PMH_PREMISE_EVIDENCE_ROUTING_TICK_MS=15000
PMH_PREMISE_EVIDENCE_ROUTER_MODEL=deepseek-v4-flash
PMH_PREMISE_EVIDENCE_ROUTER_MAX_OUTPUT_TOKENS=2400
PMH_PREMISE_EVIDENCE_ROUTER_TIMEOUT_MS=300000
PMH_PREMISE_ROUTE_EXPANSION_TICK_MS=0
PMH_PREMISE_ANALYSIS_MODEL=deepseek-v4-flash
PMH_PREMISE_ANALYSIS_MAX_OUTPUT_TOKENS=1800
PMH_PREMISE_ANALYSIS_TIMEOUT_MS=300000
PMH_PREMISE_ANALYSIS_CONCURRENCY=3
# Optional probabilistic semantic-risk estimators. These Agent-first workers
# must record an adverse counter-scenario before they can submit an interval or
# abstain. The timeout covers the complete AI SDK tool loop (max: 5 minutes).
# 0 disables automatic role dispatch; otherwise poll durable jobs every
# 1000-60000 milliseconds. Manual research runs remain available while off.
PMH_PROBABILITY_ESTIMATION_TICK_MS=0
PMH_PROBABILITY_ESTIMATION_MODEL=deepseek-v4-flash
PMH_PROBABILITY_ESTIMATION_MAX_OUTPUT_TOKENS=1200
PMH_PROBABILITY_ESTIMATION_TIMEOUT_MS=300000
# Optional: 1-8 concurrent independent advisory review requests. Default: 3.
PMH_SEMANTIC_REVIEW_CONCURRENCY=3
# Complete AI SDK tool-loop deadline (1000-600000 ms). Default: 5 minutes.
PMH_SEMANTIC_REVIEW_TIMEOUT_MS=300000
# Per-step advisory output ceiling (512-4096 tokens).
PMH_SEMANTIC_REVIEW_MAX_OUTPUT_TOKENS=1800
