{
  "name": "prediction-market-harness",
  "version": "0.1.0",
  "private": true,
  "description": "Auto Prediction: an AI-native semantic arbitrage research harness for prediction markets.",
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "check": "pnpm -r check",
    "discovery:smoke": "pnpm --filter @pmh/control-plane smoke:provider",
    "investigation:smoke": "pnpm --filter @pmh/control-plane smoke:investigator",
    "semantic-constraint:smoke": "pnpm --filter @pmh/control-plane smoke:semantic-constraint",
    "evidence-document:smoke": "pnpm --filter @pmh/control-plane smoke:evidence-document",
    "rule-evidence-claim:smoke": "pnpm --filter @pmh/control-plane smoke:rule-evidence-claim",
    "fixtures:capture": "node scripts/capture-public-fixtures.mjs",
    "fixtures:capture:streams": "node scripts/capture-public-stream-fixtures.mjs",
    "pmh": "pnpm --silent --filter @pmh/cli build && node packages/cli/dist/main.js",
    "studio": "node scripts/studio.mjs",
    "studio:build": "pnpm --filter @pmh/control-plane build && pnpm --filter @pmh/studio build",
    "test": "node --test scripts/studio-runtime-config.test.mjs scripts/studio-supervisor.test.mjs scripts/studio-harness-smoke.test.mjs && pnpm -r test",
    "test:coverage": "pnpm -r test:coverage"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "esbuild": "^0.28.1",
    "fast-check": "^4.2.0",
    "socket.io-client": "^4.8.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
