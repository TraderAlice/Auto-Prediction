{
  "compilerOptions": {
    "composite": true,
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowSyntheticDefaultImports": true,
    "noEmit": true,
    "skipLibCheck": true,
    "tsBuildInfoFile": "dist/.tsconfig-node.tsbuildinfo",
    "types": ["node"]
  },
  "include": ["vite.config.ts"]
}
