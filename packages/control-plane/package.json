{
  "name": "@pmh/control-plane",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json && esbuild src/main.ts src/provider-smoke-main.ts src/pi-investigator-smoke-main.ts src/semantic-constraint-smoke-main.ts src/evidence-document-smoke-main.ts src/pi-market-tools-extension.ts --bundle --platform=node --format=esm --external:ai --external:@ai-sdk/deepseek --external:@ai-sdk/openai --external:@earendil-works/pi-coding-agent --external:pdfjs-dist/legacy/build/pdf.mjs --external:typebox --outdir=dist",
    "check": "tsc -b tsconfig.json",
    "dev": "tsx watch src/main.ts",
    "smoke:provider": "tsx src/provider-smoke-main.ts",
    "smoke:investigator": "tsx src/pi-investigator-smoke-main.ts",
    "smoke:semantic-constraint": "tsx src/semantic-constraint-smoke-main.ts",
    "smoke:evidence-document": "tsx src/evidence-document-smoke-main.ts",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@ai-sdk/deepseek": "3.0.19",
    "@ai-sdk/openai": "4.0.27",
    "@earendil-works/pi-coding-agent": "0.83.0",
    "@pmh/domain": "workspace:*",
    "@pmh/evidence": "workspace:*",
    "@pmh/execution": "workspace:*",
    "@pmh/market-state": "workspace:*",
    "@pmh/opportunity": "workspace:*",
    "@pmh/protocol": "workspace:*",
    "@pmh/venue-gemini": "workspace:*",
    "@pmh/venue-kalshi": "workspace:*",
    "@pmh/venue-limitless": "workspace:*",
    "@pmh/venue-myriad": "workspace:*",
    "@pmh/venue-opinion": "workspace:*",
    "@pmh/venue-polymarket": "workspace:*",
    "@pmh/venue-polymarket-us": "workspace:*",
    "ai": "7.0.48",
    "jsonrepair": "3.15.0",
    "pdfjs-dist": "6.2.108",
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "tsx": "^4.23.1"
  }
}
